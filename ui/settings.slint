// The settings window: a sidebar of pages (in the style of Claude's desktop sidebar) and the page, in the dark
// Windows 11 Settings look. Everything here is filled in and handled by src/settings_ui.rs.

import { Palette } from "std-widgets.slint";
import { Colors, NavItem } from "widgets.slint";
import { Cfg, Chip, PreviewItem, PreviewRow } from "types.slint";
import { OverlayPage } from "pages/overlay.slint";
import { LayoutPage } from "pages/layout.slint";
import { DataPage } from "pages/data.slint";
import { CapturePage } from "pages/capture.slint";
import { EffectsPage } from "pages/effects.slint";
import { GeneralPage } from "pages/general.slint";
import { AboutPage } from "pages/about.slint";

export { Cfg, Chip, PreviewItem, PreviewRow }

export component SettingsWindow inherits Window {
    title: "Maple EXP Overlay - Settings";
    icon: @image-url("../assets/icon.png");
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    background: Colors.window;
    preferred-width: 920px;
    preferred-height: 760px;
    min-width: 800px;
    min-height: 600px;
    init => { Palette.color-scheme = ColorScheme.dark; }

    /// The page showing: 0 Overlay, 1 Layout, 2 Data, 3 Capture, 4 Effects, 5 General, 6 About.
    in-out property <int> page: 0;

    in-out property <Cfg> cfg;
    in property <[string]> fonts;
    in property <[string]> themes;
    in property <[string]> layouts;
    in-out property <int> font-index;
    in-out property <string> font-name;
    in property <string> region-text;
    // the map name (see maple_exp::map): its area, and the maps read so far (one per line)
    in property <string> map-region-text;
    in property <int> map-count;
    in property <string> maps-read;
    /// HDR is on for the game's screen (the map is then read from a 16-bit capture).
    in property <bool> hdr;
    in property <string> test-text;
    in property <bool> test-ok;
    in property <image> test-image;
    in property <bool> has-test-image;
    in property <string> test-caption;
    /// Text of the "switch capture method" button the test offers; empty = no button.
    in property <string> switch-label;
    /// Seconds left before "Test in game" looks at the screen; 0 = not counting.
    in property <int> test-countdown: 0;
    in property <string> version;
    /// The update check's result in words; empty before the first check.
    in property <string> update-text;
    /// A newer version that can be installed ("v0.4.0"); empty = no install button.
    in property <string> update-tag;
    /// A check or an install is running (the buttons wait).
    in property <bool> update-busy;
    /// A newer version that is downloaded and checked ("v0.5.0"): "Relaunch to update" shows.
    in property <string> update-ready;
    in property <string> data-folder;

    /// The Overlay page's preview: the layout's shown items, row by row.
    in property <[PreviewRow]> preview;
    // layout editor state (all set from Rust)
    in property <[Chip]> chips;
    in property <length> editor-h: 120px;
    in property <length> chip-font: 13px;
    in property <bool> dragging;
    in property <Chip> ghost;
    in property <length> caret-x;
    in property <length> caret-y;
    in property <length> caret-w: 3px;
    in property <length> caret-h;
    in property <length> newrow-y;
    /// The colours an item can take (the first three are the overlay theme's).
    in property <[color]> palette;
    // the selected item: Rust keeps it by id (its place in the list changes when chips are dragged)
    in-out property <string> selected-id;
    in property <bool> has-selection;
    in property <string> selected-name;
    in property <bool> selected-shown;
    in property <bool> selected-fill;
    in property <int> selected-tone;

    callback changed();
    callback theme-picked(int);
    callback layout-picked(int);
    callback font-picked(string);
    callback hex-edited(int, string);
    callback drag-down(length, length);
    callback drag-move(length, length);
    callback drag-up(length, length);
    callback chip-right-click(length, length) -> bool;
    callback color-picked(int);
    callback fill-toggled();
    callback show-toggled();
    callback select-area();
    callback test-area();
    callback test-in-game();
    callback switch-capture();
    callback select-map();
    callback clear-map();
    callback reset-position();
    callback reset-all();
    callback open-folder();
    callback preview-effects();
    callback check-update();
    callback install-update();
    callback open-releases();

    HorizontalLayout {
        // the sidebar
        Rectangle {
            width: 210px;
            background: Colors.sidebar;
            VerticalLayout {
                padding: 12px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 2px;
                for item[i] in [
                    { label: "Overlay", icon: "M2.5 3.5 H13.5 V12.5 H2.5 Z M2.5 6 H13.5" },
                    { label: "Layout", icon: "M2.5 2.5 H13.5 V6.5 H2.5 Z M2.5 9.5 H7.5 V13.5 H2.5 Z M9.5 9.5 H13.5 V13.5 H9.5 Z" },
                    { label: "Data", icon: "M2.5 13.5 L6 8.5 L9 11 L13.5 4" },
                    { label: "Capture", icon: "M2.5 5.5 V2.5 H5.5 M10.5 2.5 H13.5 V5.5 M13.5 10.5 V13.5 H10.5 M5.5 13.5 H2.5 V10.5" },
                    { label: "Effects", icon: "M8 2 L9.4 5.6 L13 7 L9.4 8.4 L8 12 L6.6 8.4 L3 7 L6.6 5.6 Z" },
                    { label: "General", icon: "M2.5 4.5 H13.5 M2.5 8 H13.5 M2.5 11.5 H13.5" },
                ]: NavItem {
                    label: item.label;
                    icon: item.icon;
                    selected: root.page == i;
                    clicked => { root.page = i; }
                }
                Rectangle { vertical-stretch: 1; }
                // a new version is downloaded and checked: one click swaps it in and restarts the overlay
                if root.update-ready != "": Rectangle {
                    height: 44px;
                    border-radius: 10px;
                    background: update-ta.has-hover ? #333331 : #2b2b2a;
                    border-width: 1px;
                    border-color: #3a3a38;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Text {
                            text: root.update-busy ? "Installing \{root.update-ready}..." : "Relaunch to update";
                            font-weight: 600;
                            color: #f2f0ed;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            Path {
                                width: 16px;
                                height: 16px;
                                viewbox-width: 16;
                                viewbox-height: 16;
                                commands: "M3 8 H13 M9 4 L13 8 L9 12";
                                stroke: #b5b2ac;
                                stroke-width: 1.4px;
                                fill: transparent;
                            }
                        }
                    }
                    update-ta := TouchArea {
                        mouse-cursor: pointer;
                        enabled: !root.update-busy;
                        clicked => { root.install-update(); }
                    }
                }
                Rectangle { height: 6px; }
                Rectangle { height: 1px; background: #2e2e2c; }
                Rectangle { height: 6px; }
                NavItem {
                    label: "About";
                    icon: "M2 8 A6 6 0 1 0 14 8 A6 6 0 1 0 2 8 Z M8 7.5 V11 M8 5 V5.3";
                    selected: root.page == 6;
                    clicked => { root.page = 6; }
                }
            }
        }

        // the page
        Rectangle {
            horizontal-stretch: 1;
            background: Colors.pane;
            border-top-left-radius: 8px;
            border-width: 1px;
            border-color: Colors.pane-border;
            if root.page == 0: OverlayPage {
                cfg <=> root.cfg;
                themes: root.themes;
                fonts: root.fonts;
                font-index: root.font-index;
                font-name: root.font-name;
                preview: root.preview;
                changed => { root.changed(); }
                theme-picked(i) => { root.theme-picked(i); }
                font-picked(f) => { root.font-picked(f); }
                hex-edited(i, t) => { root.hex-edited(i, t); }
                reset-position => { root.reset-position(); }
            }
            if root.page == 1: LayoutPage {
                cfg: root.cfg;
                font-name: root.font-name;
                layouts: root.layouts;
                chips: root.chips;
                editor-h: root.editor-h;
                chip-font: root.chip-font;
                dragging: root.dragging;
                ghost: root.ghost;
                caret-x: root.caret-x;
                caret-y: root.caret-y;
                caret-w: root.caret-w;
                caret-h: root.caret-h;
                newrow-y: root.newrow-y;
                palette: root.palette;
                has-selection: root.has-selection;
                selected-name: root.selected-name;
                selected-shown: root.selected-shown;
                selected-fill: root.selected-fill;
                selected-tone: root.selected-tone;
                layout-picked(i) => { root.layout-picked(i); }
                drag-down(x, y) => { root.drag-down(x, y); }
                drag-move(x, y) => { root.drag-move(x, y); }
                drag-up(x, y) => { root.drag-up(x, y); }
                chip-right-click(x, y) => { return root.chip-right-click(x, y); }
                color-picked(i) => { root.color-picked(i); }
                fill-toggled => { root.fill-toggled(); }
                show-toggled => { root.show-toggled(); }
            }
            if root.page == 2: DataPage {
                cfg <=> root.cfg;
                changed => { root.changed(); }
            }
            if root.page == 3: CapturePage {
                cfg <=> root.cfg;
                region-text: root.region-text;
                test-text: root.test-text;
                test-ok: root.test-ok;
                test-image: root.test-image;
                has-test-image: root.has-test-image;
                test-caption: root.test-caption;
                switch-label: root.switch-label;
                test-countdown: root.test-countdown;
                map-region-text: root.map-region-text;
                map-count: root.map-count;
                maps-read: root.maps-read;
                hdr: root.hdr;
                changed => { root.changed(); }
                select-area => { root.select-area(); }
                test-area => { root.test-area(); }
                test-in-game => { root.test-in-game(); }
                switch-capture => { root.switch-capture(); }
                select-map => { root.select-map(); }
                clear-map => { root.clear-map(); }
            }
            if root.page == 4: EffectsPage {
                cfg <=> root.cfg;
                changed => { root.changed(); }
                preview-effects => { root.preview-effects(); }
            }
            if root.page == 5: GeneralPage {
                cfg <=> root.cfg;
                data-folder: root.data-folder;
                changed => { root.changed(); }
                open-folder => { root.open-folder(); }
                reset-all => { root.reset-all(); }
            }
            if root.page == 6: AboutPage {
                version: root.version;
                update-text: root.update-text;
                update-tag: root.update-tag;
                update-busy: root.update-busy;
                update-ready: root.update-ready;
                check-update => { root.check-update(); }
                install-update => { root.install-update(); }
                open-releases => { root.open-releases(); }
            }
        }
    }
}
